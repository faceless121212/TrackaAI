# Data backend: "mock" (local JSON file; used by CI and e2e) or "supabase" (hosted project).
DATA_BACKEND=mock

# Supabase (DATA_BACKEND=supabase). Both values are public: they ship to the browser.
# Project Settings → API. The app never needs the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Mock backend only: JSON file holding all data (seeded with a demo account when missing)
MOCK_DB_PATH=.data/mock-db.json
# Mock backend only: HMAC secret for session cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin for links that leave the app (invite links, emails). Required in production.
APP_URL=http://localhost:3000

# AI (task writer, breakdown). Server-only secret: never prefix with NEXT_PUBLIC_.
# Without it the AI buttons are hidden. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# 1 = stream canned output from a mock model instead of calling Anthropic (e2e sets this).
AI_MOCK=
# Signs the copilot's tool approvals (any long random string, e.g. `openssl rand -base64 32`).
# Required when more than one server instance runs; locally each process makes its own.
TOOL_APPROVAL_SECRET=
# Supabase backend: proves AI teammate run steps come from this server, so a member's
# browser can't post as a teammate. At least 32 characters (`openssl rand -hex 32`).
# The database stores only its SHA-256 in private.worker_secrets (see the
# 20261001100000_agent_worker_token migration); without it, AI teammates are off.
AGENT_WORKER_SECRET=

# Password of the dev accounts (demo@ / mate@trackaai.test) when it differs from the
# public seed one ("demo-password"); used by `pnpm test:supabase` and `pnpm test:smoke`.
DEMO_PASSWORD=

# Development only: 1 = log every Supabase request (method, path, duration) to find slow pages.
DEBUG_SUPABASE=
